      "id": "dnscat2",
      "entry": "scripts/dnscat2/main.zeek",
      "title": "dnscat2 DNS session",
      "description": "Correlates actual TXT, CNAME, MX, A and AAAA DNS answers with retained requests. Distinct paired negotiation keys, paired SYN and MSG stages, matching session IDs and generation guards qualify the pattern. Standalone processing is incremental; the optional finite adapter invokes the same lifecycle after a complete assigned input window.",
      "files": [
        {
          "path": "scripts/dnscat2/main.zeek",
          "label": "Detection",
          "role": "entry"
        },
        {
          "path": "scripts/dnscat2/cluster.zeek",
          "label": "Finite PCAP adapter",
          "role": "optional"
        }
      ],
      "captures": [
        {
          "repository": "Pb-22/Network_Detections",
          "path": "dnscat2/pcap/dnscat2-txt-positive-complete-session.pcap",
          "label": "Native TXT session with documented endpoint replacement",
          "expected_notices": 1,
          "provenance": "Derived from a native lab capture; outer endpoint addresses replaced"
        }
      ],
      "capture_guide": {
        "repository": "Pb-22/Network_Detections",
        "path": "dnscat2/README.md"
      }
    },
